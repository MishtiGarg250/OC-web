# SMTP server used by the sponsor registration API.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-smtp-account@example.com
SMTP_PASS=your-app-password

# Must be an address the SMTP provider permits SMTP_USER to send from.
SMTP_FROM=your-smtp-account@example.com

# Optional. Defaults to geekhaven@iiita.ac.in.
INTERNAL_NOTIFICATION_TO=geekhaven@iiita.ac.in
